            },
            {
                "Name": "safetyp1"
            }
        ],
        "Website": "https://github.com/safetyp1/Windows7StartMenu4KDE",
        "BugReportUrl": "https://github.com/safetyp1/Windows7StartMenu4KDE/issues"
